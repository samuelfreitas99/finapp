{
  "name": "@finapp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "invite:create": "tsx src/cli/create-invite-cli.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@fastify/static": "^10.1.5",
    "@finapp/core": "workspace:*",
    "@finapp/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "uuidv7": "^1.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15"
  }
}
