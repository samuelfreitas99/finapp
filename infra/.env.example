# Copie para infra/.env e preencha. Nunca commite o .env.

# Banco (produção)
POSTGRES_USER=finapp
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=finapp

# App
APP_URL=https://financas.voleidraft.top
# Domínios antigos que redirecionam (301) para APP_URL, separados por vírgula (ver docs/trocar-dominio.md)
REDIRECT_HOSTS=
FINAPP_HOST_PORT=3010
LOG_LEVEL=info

# Autenticação (Fase 2): gere com `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# E-mail (esqueci a senha). Vazio = não envia; o link sai por `node server.cjs --reset-link email`.
# Gmail: ative a verificação em 2 etapas e crie uma "senha de app" (16 letras).
# SMTP_URL=smtps://seu-email%40gmail.com:senha-de-app@smtp.gmail.com:465
# MAIL_FROM=FinApp <seu-email@gmail.com>

# Web Push (Fase 6): gere com `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Backup (finapp-backup): gere a senha com `openssl rand -base64 32` e GUARDE-A
# fora do servidor; sem ela os backups não podem ser lidos.
RESTIC_PASSWORD=
# Destino do restic. Vazio = repositório local em BACKUP_LOCAL_DIR.
# Externo (exemplos): b2:meu-bucket:finapp  |  rclone:gdrive:finapp
RESTIC_REPOSITORY=
BACKUP_LOCAL_DIR=/srv/finapp-backups/restic
BACKUP_CRON=0 3 * * *
# Credenciais do destino externo, conforme o tipo:
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# RCLONE_CONFIG_GDRIVE_TYPE=drive  (e demais RCLONE_CONFIG_GDRIVE_* gerados pelo `rclone config`)

# Desenvolvimento local (Postgres do docker-compose.dev.yml)
# DATABASE_URL=postgres://finapp:finapp@127.0.0.1:5433/finapp
